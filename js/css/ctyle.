body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    text-align: center;
    background-color: #e8f5e9;
    padding: 20px;
    color: #2e7d32;
}

h1 { margin-bottom: 10px; }
p { margin-bottom: 30px; font-size: 18px; }

#main-container {
    width: 600px;
    height: 400px;
    margin: 0 auto 30px;
    background-color: #fff;
    background-size: cover;
    background-position: center;
    border: 5px solid #81c784;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    transition: background-image 0.4s ease-in-out;
}

#main-text {
    background-color: rgba(255, 255, 255, 0.85);
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 20px;
    font-weight: bold;
    color: #1b5e20;
    max-width: 80%;
}

/* Cập nhật để chứa 6 ảnh gọn gàng hơn */
.thumbnail-list {
    display: flex;
    flex-wrap: wrap; /* Tự động xuống dòng nếu không đủ chỗ */
    justify-content: center;
    gap: 15px;
    max-width: 800px;
    margin: 0 auto;
}

.thumbnail {
    width: 150px;
    height: 100px;
    object-fit: cover;
    border: 3px solid #a5d6a7;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.3s, border-color 0.3s, outline 0.1s;
}

/* Hiệu ứng khi di chuột (Hover) */
.thumbnail:hover {
    transform: scale(1.1);
    border-color: #2e7d32;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}

/* YÊU CẦU BÀI TẬP: Hiệu ứng khi dùng phím Tab (Focus) */
.thumbnail:focus {
    outline: 4px solid #ff9800; /* Viền màu cam nổi bật */
    transform: scale(1.1);
    border-color: #2e7d32;
}
